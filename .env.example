# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Automatically injected by Railway in production (defaults to 3000 locally)
PORT=3000

# Discord Bot Authentication (Bot-only, no OAuth2 login required)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=
DISCORD_SUPPORT_INVITE=https://discord.gg/shadowmusic

# Lavalink v4 Node Configuration
# On Railway private networking, set LAVALINK_HOST=lavalink.railway.internal and LAVALINK_PORT=2333
# (or set LAVALINK_URL=https://your-lavalink.up.railway.app for public TLS endpoints)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NAME=Shadow-Node-01

